# Vôlei+ - variáveis de ambiente do back-end
# Copie para .env e substitua valores locais conforme necessário.

# Banco de dados
DATABASE_URL=postgresql://volei_user:volei_pass@localhost:5432/volei_plus

# Segurança
SECRET_KEY=gere-uma-chave-secreta-forte-com-openssl-rand-base64-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Aplicação
APP_NAME=Vôlei+
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
